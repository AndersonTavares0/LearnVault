# Copy to .env for local Docker Compose use; replace the initial password.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-at-least-12-characters
PORT=8090
LISTEN_ADDR=0.0.0.0
DATA_DIR=../../data
CACHE_DIR=../../cache
# Pasta semente do primeiro curso (registrada com a identidade library-1); cursos
# adicionais entram pela interface, em courses.json ao lado do banco.
LIBRARY_DIR=../../testdata/library
COOKIE_SECURE=false
