# LearnVault - Configuração do Ambiente Docker (.env)
# Copie este arquivo para .env no diretório deploy/compose/ e defina sua senha segura.

# Credenciais do administrador inicial (mínimo de 12 caracteres)
ADMIN_USERNAME=owner
ADMIN_PASSWORD=substitua-por-ao-menos-12-caracteres

# Portas e endereço de escuta
PORT=8090
BIND_ADDR=127.0.0.1
LISTEN_ADDR=0.0.0.0

# Caminhos locais para persistência
DATA_DIR=../../data
CACHE_DIR=../../cache

# Pasta semente do primeiro curso (montada como somente leitura)
LIBRARY_DIR=../../testdata/library

# Cookies seguros (padrão seguro com HTTPS / proxy reverso Caddy)
COOKIE_SECURE=true

# Imagem OCI (utilize tags versionadas em produção, ex: ghcr.io/learnvault/learnvault:v0.4.0)
LEARNVAULT_IMAGE=learnvault-rust:local

# Atualizações automáticas opt-in (desativadas por padrão para total controle do operador)
AUTO_UPDATE=false
AUTO_UPDATE_WINDOW=03:00-05:00
