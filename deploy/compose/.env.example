# LearnVault - Docker environment configuration (.env)
# Copy this file to .env in the deploy/compose/ directory and set a strong password.

# Initial administrator credentials (at least 12 characters)
ADMIN_USERNAME=owner
ADMIN_PASSWORD=
TRUSTED_PROXY_IPS=

# Ports and listen address
TZ=UTC
PORT=8090
BIND_ADDR=127.0.0.1
LISTEN_ADDR=0.0.0.0

# Local paths for persistence
DATA_DIR=../../data
CACHE_DIR=../../cache

# Seed folder of the first course (mounted read-only)
LIBRARY_DIR=../../testdata/library

# Secure cookies (the safe default with HTTPS / the Caddy reverse proxy).
# If you reach the server directly over HTTP on a local IP/port (no HTTPS), set this to false so the session cookie works in the browser.
COOKIE_SECURE=true

# Official OCI image published on the GitHub Container Registry (GHCR). This is the default of
# compose.yaml; set it only to pin a version (e.g. ...learnvault:0.9.0).
# LEARNVAULT_IMAGE=ghcr.io/andersontavares0/learnvault:latest

# Opt-in automatic updates (off by default so the operator stays in full control)
AUTO_UPDATE=false
AUTO_UPDATE_WINDOW=03:00-05:00
