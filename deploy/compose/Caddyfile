{
    # Disables telemetry for greater privacy
    admin off
}

{$DOMAIN:localhost} {
    encode zstd gzip

    # Recommended OWASP security headers for self-hosting
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Reverse proxy to the LearnVault container
    reverse_proxy learnvault:8090 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up X-Real-IP {remote_host}
        
        # Streaming optimization for videos and HTTP Range requests (206 Partial Content)
        buffer_responses off
    }
}
