# EXPERIMENTAL, NON-PUBLISHING OCI definition for the Rust rewrite.
#
# Purpose: validate that the Rust server in `crates/server` builds from repository
# sources and can run inside a container against a read-only library and a writable
# data directory. This is a scaffolding image for local/manual validation only.
#
# Compose uses this image for the Rust deployment cutover. The Go service and its
# release/CI definitions remain in the repository as a legacy reference and are not
# removed by this slice.
#
# Build (from the repository root):
#   docker build -f deploy/container/Containerfile.rust -t learnvault-rust-validation:local .
#
# Run the automated validation instead of invoking the engine by hand:
#   ./scripts/verify-rust-oci.sh
#
# The build stages need network access to download the Rust and Node dependencies. The alpine
# variant targets x86_64-unknown-linux-musl, producing a static binary that runs on the
# alpine runtime. `build-base` supplies the C toolchain required by rusqlite's bundled
# SQLite. `rust-toolchain.toml` is deliberately not copied so the build uses the image
# toolchain instead of trying to download a pinned one.

FROM node:24-alpine AS web-build
WORKDIR /src
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN corepack enable && corepack install --global pnpm@11.28.5 && pnpm install --frozen-lockfile
COPY apps/web apps/web
RUN pnpm --filter learnvault-web build

FROM rust:1.99-alpine AS rust-build
RUN apk add --no-cache build-base
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release --locked --package learnvault-server

FROM alpine:3.24
RUN apk add --no-cache ca-certificates wget \
    && addgroup -S -g 10001 learnvault \
    && adduser -S -D -H -u 10001 -G learnvault learnvault
WORKDIR /app
COPY --from=rust-build --chown=10001:10001 /src/target/release/learnvault-server /app/learnvault-server
COPY --from=web-build --chown=10001:10001 /src/services/go/cmd/learnvault/web/build /app/web
USER 10001:10001
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q -O - http://127.0.0.1:8090/api/healthz >/dev/null || exit 1
ENTRYPOINT ["/app/learnvault-server", "--web-root", "/app/web"]
