{
  "name": "learnvault-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"dev": "vite",
		"dev:tauri": "vite build --mode desktop --watch",
		"build": "vite build",
		"build:desktop": "vite build --mode desktop",
		"test": "vitest run"
  },
  "dependencies": {
		"@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^4.0.0"
  }
}
