{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LearnVault",
  "identifier": "app.learnvault.desktop",
  "build": {
    "frontendDist": "frontend-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LearnVault",
        "url": "200.html",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost learnvault-media: http://learnvault-media.localhost learnvault-cover: http://learnvault-cover.localhost data: blob:; media-src 'self' asset: http://asset.localhost learnvault-media: http://learnvault-media.localhost blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4QTA1RDVDNzY4MTQ1NTQKUldSVVJZRjJYRjJnT0VwZG12RE9PdlpyRE04c1JuTUVNbHh1TEU1ZUprclVVZXYrWTh6TDV4Q1oK",
      "endpoints": [
        "https://github.com/AndersonTavares0/LearnVault/releases/latest/download/latest.json"
      ]
    }
  }
}
