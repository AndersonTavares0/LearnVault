{
  "identifier": "main-window",
  "description": "Minimal Tauri core permissions for the LearnVault desktop main window. In addition to the application's IPC commands, the title bar uses window permissions to minimize, maximize or restore, close, drag, and query its state. The native course and cover picker runs in Rust; rescanning is explicit, the study owner is fixed in Rust, and manual ordering lives in the application directory. No shell, process, HTTP, broad filesystem, dialog, store, remote, or direct updater permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "allow-desktop-catalog",
    "allow-desktop-import-course",
    "allow-desktop-remove-course",
    "allow-desktop-import-course-cover",
    "allow-desktop-remove-course-cover",
    "allow-desktop-rescan",
    "allow-desktop-search",
    "allow-desktop-study-progress",
    "allow-desktop-record-position",
    "allow-desktop-set-completed",
    "allow-desktop-recent-study",
    "allow-desktop-study-state",
    "allow-desktop-study-summary",
    "allow-desktop-list-notes",
    "allow-desktop-create-note",
    "allow-desktop-update-note",
    "allow-desktop-delete-note",
    "allow-desktop-list-pdf-annotations",
    "allow-desktop-create-pdf-annotation",
    "allow-desktop-update-pdf-annotation",
    "allow-desktop-delete-pdf-annotation",
    "allow-desktop-list-flashcards",
    "allow-desktop-list-all-flashcards",
    "allow-desktop-create-flashcard",
    "allow-desktop-update-flashcard",
    "allow-desktop-delete-flashcard",
