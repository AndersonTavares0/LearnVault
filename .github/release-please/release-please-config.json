{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "release-type": "simple",
      "version-file": ".github/release-please/version.txt",
      "changelog-path": "docs/releases/CHANGELOG.md",
      "include-v-in-tag": true,
      "include-v-in-release-name": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "versioning": "default",
      "prerelease": false,
      "pull-request-title-pattern": "chore: release ${version}",
      "pull-request-header": "Release Please generated this release from Conventional Commits.",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true },
        { "type": "chore", "section": "Maintenance", "hidden": true },
        { "type": "refactor", "section": "Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "Continuous Integration", "hidden": true }
      ]
    }
  }
}
