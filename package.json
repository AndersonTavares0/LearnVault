{
  "name": "learnvault",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.5",
  "license": "MIT",
  "scripts": {
    "check": "pnpm -r check",
    "build": "pnpm --filter learnvault-web-next build",
    "build:desktop": "pnpm --filter learnvault-web-next build:desktop",
    "dev": "node scripts/dev.mjs localhost",
    "dev:localhost": "node scripts/dev.mjs localhost",
    "dev:tauri": "node scripts/dev.mjs tauri",
    "dev:next": "pnpm --filter learnvault-web-next dev",
    "verify": "node scripts/verify.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\" \".opencode/plugins/*.test.mjs\"",
    "e2e:server": "pnpm run build && cargo build -p learnvault-server && pnpm exec playwright test tests/e2e/web-next.spec.ts tests/e2e/web-next-rich.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4"
  }
}
