{
  "name": "learnvault",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.5",
  "license": "MIT",
  "scripts": {
    "check": "pnpm -r check",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter learnvault-web build:desktop",
    "dev": "node scripts/dev.mjs localhost",
    "dev:localhost": "node scripts/dev.mjs localhost",
    "dev:tauri": "node scripts/dev.mjs tauri",
    "verify": "node scripts/verify.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "e2e:server": "pnpm run build && cargo build -p learnvault-server && pnpm exec playwright test tests/e2e/server.spec.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@playwright/test": "1.64.1"
  }
}
