{
  "name": "learnvault-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-kit sync && vite build"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.25.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
